<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 成员头像/照片 -->
        <ImageView
            android:id="@+id/iv_member_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_default_avatar"
            android:scaleType="centerCrop"
            android:contentDescription="成员照片"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 成员姓名 -->
        <TextView
            android:id="@+id/tv_member_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="成员姓名"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintTop_toTopOf="@id/iv_member_avatar"
            app:layout_constraintBottom_toTopOf="@id/tv_member_status"
            app:layout_constraintStart_toEndOf="@id/iv_member_avatar"
            app:layout_constraintEnd_toStartOf="@id/btn_upload_photo" />

        <!-- 成员状态 -->
        <TextView
            android:id="@+id/tv_member_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="已激活"
            android:textSize="12sp"
            android:textColor="@color/green"
            app:layout_constraintTop_toBottomOf="@id/tv_member_name"
            app:layout_constraintBottom_toBottomOf="@id/iv_member_avatar"
            app:layout_constraintStart_toEndOf="@id/iv_member_avatar" />

        <!-- 上传照片按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_upload_photo"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="上传照片"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:layout_constraintTop_toTopOf="@id/iv_member_avatar"
            app:layout_constraintBottom_toTopOf="@id/btn_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:strokeWidth="1dp" />

        <!-- 删除按钮 -->
        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="删除成员"
            android:scaleType="centerInside"
            app:tint="@color/red"
            app:layout_constraintTop_toBottomOf="@id/btn_upload_photo"
            app:layout_constraintBottom_toBottomOf="@id/iv_member_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
